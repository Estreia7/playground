# Listen port for the Express service. The Next.js app rewrites
# /api/airbnb/* to http://127.0.0.1:${PORT}/api/*
PORT=4001

# How fresh a previous analysis must be (in days) to skip Playwright
# and return cached results.
CACHE_TTL_DAYS=7

# When 1, the scraper modules return deterministic synthetic data
# (useful for testing the pipeline without hitting Airbnb).
# Default 0 — real scraping via Playwright + stealth.
SCRAPER_STUB=0

# Time zone used to compute "next 12 calendar months". Never trust the
# OS implicit clock — set this explicitly.
TZ=Europe/Lisbon

# Currency to force on Airbnb (so ADR is comparable across listings).
CURRENCY=EUR

# Path to the SQLite file. Relative paths resolve against the backend folder.
DB_PATH=./data.sqlite

# Worker concurrency (max simultaneous Chromium browsers).
WORKER_POOL_SIZE=3

# --- Host analyzer ----------------------------------------------------------

# Max listings processed per host job (bounds runtime for mega-hosts).
HOST_MAX_LISTINGS=40

# How fresh an RNT registry lookup must be (days) to reuse the cached record.
RNT_CACHE_TTL_DAYS=30

# Base URL where the Next.js app serves /host-analyzer/print/:id for the
# server-side PDF render. Production runs Next on 3002; dev on 3000.
PRINT_BASE_URL=http://127.0.0.1:3002
