# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# monte-scan stored documents
/storage/monte-scan

# LFP contribution tickets hold e-mail addresses — never committed.
# The datasets next to them (storage/lfp/*.json) ARE source content and stay tracked.
/storage/lfp/tickets.json
/storage/lfp/tickets.bak.json
/storage/lfp/history/

# typescript
*.tsbuildinfo
next-env.d.ts
