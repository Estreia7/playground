# FX Lab — EUR/USD pattern finder
#
# Live price feed. Twelve Data's free plan allows 8 calls a minute and 800 a
# day, which is ample: the scheduler spends one call every five minutes and
# builds every timeframe from it. Without a key the tool still works on
# backfilled Dukascopy history, it just will not update live.
FX_TWELVEDATA_KEY=

# Access gate. The playground is public, so backfills, scans, settings and the
# paper account are locked behind this password. Leave it unset and the tool is
# read-only for everyone, which is the safe default.
FX_ACCESS_PASSWORD=
# Optional: signs the session cookie. Falls back to FX_ACCESS_PASSWORD.
FX_SESSION_SECRET=

# Set to "on" to run the background scanner. Only one machine should have this
# on at a time: two schedulers sharing an API key burn the daily allowance
# twice as fast. Production only.
FX_SCHEDULER=
